# FarmMind AI environment configuration

# Ollama local LLM
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Optional: legacy placeholder kept only for compatibility
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: official district rainfall from data.gov.in. Keep the real key in .env.
DATA_GOV_IN_API_KEY=your_data_gov_in_key_here
DATA_GOV_IN_RAINFALL_RESOURCE_ID=your_district_rainfall_resource_id_here

# Optional: IMD's district rainfall endpoint requires its own IMD API key.
# FarmMind continues with the configured OGD daily-rainfall source when omitted.
IMD_API_KEY=your_imd_api_key_here

# Optional: OGD crop-production resource used by scripts/build_odisha_sample_data.py.
DATA_GOV_IN_CROP_RESOURCE_ID=35be999b-0208-4354-b557-f6ca9a5355de

# Optional: Gemini-powered English/Hindi crop-plan and What-If narration.
# Keep your real key in .env; never commit it or place it in browser JavaScript.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
